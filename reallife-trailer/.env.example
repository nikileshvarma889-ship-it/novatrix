# Copy to .env (never commit .env). Keys stay on this machine and are only sent to Google's API.
# Video: a Google AI (Gemini API) key from a project with billing enabled and Veo access.
VEO_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=1080p
# Images: any Gemini API key (the free tier works).
GEMINI_API_KEY=
IMAGE_MODEL=gemini-3-pro-image-preview
