      "ev": {
        "rupture": 4.676
      }
    },
    {
      "id": "s4a",
      "name": "Rocket",
      "lines": [
        {
          "key": "s4a_0",
          "who": "NARRATOR",
          "text": "But how do some fireworks fly? Rockets move upward because gases escape downward, producing thrust.",
          "sub": "But how do some fireworks fly? Rockets move upward because gases escape downward, producing thrust.",
          "radio": false,
          "fiction": false,
          "label": "",
