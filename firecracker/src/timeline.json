      "name": "Intro",
      "lines": [
        {
          "key": "s1_0",
          "who": "NARRATOR",
          "text": "Have you ever wondered, what actually happens inside a firecracker when it explodes?",
          "sub": "Have you ever wondered… what actually happens inside a firecracker when it explodes?",
          "radio": false,
          "fiction": false,
          "label": "",
