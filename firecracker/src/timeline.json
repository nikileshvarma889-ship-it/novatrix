    {
      "id": "s2",
      "name": "Inside mechanism",
      "lines": [
        {
          "key": "s2_0",
          "who": "NARRATOR",
          "text": "Inside a typical firecracker, a fast-burning energetic material releases heat and gases.",
          "sub": "Inside a typical firecracker, a fast-burning energetic material releases heat and gases.",
          "radio": false,
          "fiction": false,
          "label": "",
          "dur": 6.177,
          "start": 0.5
        },
        {
          "key": "s2_1",
          "who": "NARRATOR",
          "text": "As the reaction happens rapidly, pressure builds inside its casing.",
          "sub": "As the reaction happens rapidly, pressure builds inside its casing.",
          "radio": false,
          "fiction": false,
          "label": "",
          "dur": 4.331,
          "start": 7.177
        }
      ],
      "caption": [],
      "end": [],
      "dur": 12.5,
      "start": 6.669,
      "ev": {
        "fuseStart": 0.6,
        "fuseEnd": 3.897
      }
    },
    {
      "id": "s3",
      "name": "The explosion",
      "lines": [
        {
          "key": "s3_0",
          "who": "NARRATOR",
          "text": "When the pressure rises extremely fast, the casing ruptures suddenly.",
          "sub": "When the pressure rises extremely fast, the casing ruptures suddenly.",
          "radio": false,
          "fiction": false,
          "label": "",
          "dur": 4.745,
          "start": 0.5
        },
        {
          "key": "s3_1",
          "who": "NARRATOR",
          "text": "The expanding gases create a loud bang, a pressure wave, and the explosive burst we hear and see.",
          "sub": "The expanding gases create a loud bang, a pressure wave, and the explosive burst we hear and see.",
          "radio": false,
          "fiction": false,
          "label": "",
          "dur": 7.128,
