# ---- Core ----
APP_NAME=Reelwise
# Public URL of the app (used for OAuth redirect URIs and the Android app)
APP_URL=http://localhost:3000
DATABASE_URL=postgres://reelwise:reelwise_dev@localhost:5432/reelwise
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Where uploads and rendered videos are stored (must be writable by web + worker)
STORAGE_DIR=./storage

# ---- Claude (optional here; each workspace can also save its own key in Settings) ----
ANTHROPIC_API_KEY=

# ---- Meta (Facebook Pages + Instagram professional accounts) ----
# developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# ---- Google (YouTube Data API v3 + YouTube Analytics API) ----
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Video engine ----
# Chrome used by Remotion to render (leave empty to let Remotion download one)
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=2
# ---- ElevenLabs voiceover (optional; each workspace can also save its own key in Settings) ----
ELEVENLABS_API_KEY=
# Voice used when a video asks for "ElevenLabs default" (name or voice ID), e.g. Bunty for Telugu
ELEVENLABS_DEFAULT_VOICE=Bunty
# eleven_v3 supports Telugu and 70+ languages
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_LANGUAGE=te

# Optional local neural voice (Piper). Leave empty to render without voiceover.
PIPER_PYTHON=
PIPER_MODEL=
